{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Services"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "estimatedDuration": {
      "type": "integer",
      "required": true
    },
    "displayOrder": {
      "type": "integer",
      "default": 0
    },
    "pricingModel": {
      "type": "enumeration",
      "required": true,
      "default": "flat",
      "enum": [
        "flat",
        "variant"
      ]
    },
    "service_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service-category.service-category",
      "inversedBy": "services"
    },
    "service_pricings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service-pricing.service-pricing",
      "mappedBy": "service"
    },
    "service_varients": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service-varient.service-varient",
      "mappedBy": "service"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "service"
    },
    "scheduleType": {
      "type": "enumeration",
      "enum": [
        "pickup_delivery",
        "appointment"
      ]
    },
    "cart_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::cart-item.cart-item",
      "mappedBy": "service"
    }
  }
}
