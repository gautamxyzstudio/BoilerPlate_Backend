{
  "kind": "collectionType",
  "collectionName": "coupons",
  "info": {
    "singularName": "coupon",
    "pluralName": "coupons",
    "displayName": "Coupon",
    "description": "Laundry Service Coupon & Promo System"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string"
    },
    "discount_type": {
      "type": "enumeration",
      "enum": [
        "FLAT",
        "PERCENTAGE"
      ],
      "required": true,
      "default": "FLAT"
    },
    "discount_value": {
      "type": "decimal",
      "required": true
    },
    "min_order_amount": {
      "type": "decimal",
      "default": 0
    },
    "max_discount_amount": {
      "type": "decimal"
    },
    "start_date": {
      "type": "datetime"
    },
    "end_date": {
      "type": "datetime"
    },
    "usage_limit": {
      "type": "integer"
    },
    "usage_limit_per_user": {
      "type": "integer",
      "default": 1
    },
    "used_count": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "coupon_usages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::coupon-usage.coupon-usage",
      "mappedBy": "coupon"
    }
  }
}
