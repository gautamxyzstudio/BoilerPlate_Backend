{
  "kind": "collectionType",
  "collectionName": "service_pricings",
  "info": {
    "singularName": "service-pricing",
    "pluralName": "service-pricings",
    "displayName": "Service Pricing"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "price": {
      "type": "decimal",
      "required": true
    },
    "offerPrice": {
      "type": "decimal"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "expressDeliveryPrice": {
      "type": "decimal"
    },
    "service": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service.service",
      "inversedBy": "service_pricings"
    },
    "service_varient": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service-varient.service-varient",
      "inversedBy": "service_pricings"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "service_pricing"
    }
  }
}
