{
  "kind": "collectionType",
  "collectionName": "driver_details",
  "info": {
    "singularName": "driver-detail",
    "pluralName": "driver-details",
    "displayName": "Driver Detail"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "phoneNumber": {
      "type": "string"
    },
    "driver_documents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::driver-document.driver-document",
      "mappedBy": "driver_detail"
    },
    "order_deliver": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order.order",
      "mappedBy": "delivery_driver"
    },
    "order_pickup": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order.order",
      "mappedBy": "pickup_driver"
    },
    "vehicleNumber": {
      "type": "string"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
