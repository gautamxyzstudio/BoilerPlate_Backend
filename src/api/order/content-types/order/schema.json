{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderNo": {
      "type": "string",
      "unique": true
    },
    "pickupDate": {
      "type": "date"
    },
    "pickupTime": {
      "type": "time"
    },
    "deliveryDate": {
      "type": "date"
    },
    "deliveryTime": {
      "type": "time"
    },
    "paymentMethod": {
      "type": "enumeration",
      "enum": [
        "online",
        "cod"
      ]
    },
    "paymentStatus": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "paid",
        "failed",
        "cancelled",
        "refunded"
      ]
    },
    "orderStatus": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "pickup_assigned",
        "picked_up",
        "processing",
        "delivery_assigned",
        "out_for_delivery",
        "delivered",
        "professional_assigned",
        "professional_on_the_way",
        "arrived",
        "service_started",
        "completed",
        "cancelled",
        "refunded"
      ]
    },
    "cancellationReason": {
      "type": "text"
    },
    "appointmentDate": {
      "type": "date"
    },
    "appointmentTime": {
      "type": "time"
    },
    "startedAt": {
      "type": "datetime"
    },
    "completedAt": {
      "type": "datetime"
    },
    "pickedUpAt": {
      "type": "datetime"
    },
    "processingStartedAt": {
      "type": "datetime"
    },
    "deliveredAt": {
      "type": "datetime"
    },
    "subTotal": {
      "type": "decimal"
    },
    "tax": {
      "type": "decimal"
    },
    "discount": {
      "type": "decimal"
    },
    "deliveryCharge": {
      "type": "decimal"
    },
    "grandTotal": {
      "type": "decimal"
    },
    "specialInstruction": {
      "type": "text"
    },
    "pickup_address": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::address.address",
      "inversedBy": "pickup_orders"
    },
    "delivery_address": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::address.address",
      "inversedBy": "delivery_orders"
    },
    "user_profile": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user-profile.user-profile",
      "inversedBy": "orders"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    },
    "payment_collections": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payment-collection.payment-collection",
      "mappedBy": "order"
    },
    "order_status_histories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-status-history.order-status-history",
      "mappedBy": "order"
    },
    "delivery_driver": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::driver-detail.driver-detail",
      "inversedBy": "order_deliver"
    },
    "pickup_driver": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::driver-detail.driver-detail",
      "inversedBy": "order_pickup"
    }
  }
}