{
  "kind": "collectionType",
  "collectionName": "service_varients",
  "info": {
    "singularName": "service-varient",
    "pluralName": "service-varients",
    "displayName": "Service Varient"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "displayOrder": {
      "type": "integer",
      "default": 0
    },
    "service": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service.service",
      "inversedBy": "service_varients"
    },
    "service_pricings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service-pricing.service-pricing",
      "mappedBy": "service_varient"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "service_varient"
    }
  }
}
