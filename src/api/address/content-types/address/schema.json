{
  "kind": "collectionType",
  "collectionName": "addresses",
  "info": {
    "singularName": "address",
    "pluralName": "addresses",
    "displayName": "Customer Address"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "streetAddress": {
      "type": "string",
      "required": true
    },
    "fullAddress": {
      "type": "text",
      "required": true
    },
    "landmark": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "required": true
    },
    "state": {
      "type": "string",
      "required": true
    },
    "postalCode": {
      "type": "string",
      "required": true
    },
    "country": {
      "type": "string",
      "required": true
    },
    "latitude": {
      "type": "string"
    },
    "longitude": {
      "type": "string"
    },
    "isDefaultAddress": {
      "type": "boolean",
      "default": false
    },
    "addressType": {
      "type": "enumeration",
      "enum": [
        "home",
        "work",
        "other"
      ]
    },
    "pickup_orders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order.order",
      "mappedBy": "pickup_address"
    },
    "delivery_orders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order.order",
      "mappedBy": "delivery_address"
    },
    "user_profile": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user-profile.user-profile",
      "inversedBy": "customer_addresses"
    },
    "pickup_cart": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::cart.cart",
      "mappedBy": "pickup_address"
    },
    "delivery_cart": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::cart.cart",
      "mappedBy": "delivery_address"
    }
  }
}
