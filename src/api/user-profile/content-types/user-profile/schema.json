{
  "kind": "collectionType",
  "collectionName": "user_profiles",
  "info": {
    "singularName": "user-profile",
    "pluralName": "user-profiles",
    "displayName": "User Profile"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string"
    },
    "phoneNumber": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "profileImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "userType": {
      "type": "enumeration",
      "enum": [
        "customer",
        "admin",
        "superAdmin"
      ]
    },
    "accountStatus": {
      "type": "enumeration",
      "enum": [
        "approved",
        "rejected",
        "blocked"
      ]
    },
    "fcmToken": {
      "type": "string"
    },
    "emailVerified": {
      "type": "boolean",
      "default": false
    },
    "phoneVerified": {
      "type": "boolean",
      "default": false
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "user_profile"
    }
  }
}
