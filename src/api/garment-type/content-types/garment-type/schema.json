{
  "kind": "collectionType",
  "collectionName": "garment_types",
  "info": {
    "singularName": "garment-type",
    "pluralName": "garment-types",
    "displayName": "Garment Type"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "service_pricings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service-pricing.service-pricing",
      "mappedBy": "garment_type"
    },
    "service": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service.service",
      "inversedBy": "garment_types"
    }
  }
}
